APP_NAME=Rosevear AI Hub
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/rosevear_ai_hub.db

# Build 016 local authentication.
AUTH_SESSION_HOURS=168
# Leave false for localhost/Tauri. Use true when served over HTTPS.
AUTH_COOKIE_SECURE=false

# Build 018 Level 2 confirmation expiry.
CONFIRMATION_TTL_SECONDS=300

# Build 020 encrypted secret storage.
# Generate a fresh 32-byte URL-safe base64 key outside source control.
# Leave SECRET_ENCRYPTION_PREVIOUS_KEY empty except during master-key rotation.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_PREVIOUS_KEY=

# Build 011 local knowledge storage.
KNOWLEDGE_STORAGE_DIR=./data/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
KNOWLEDGE_MAX_EXPANDED_DOCX_BYTES=104857600

# Build 012 local chunking and embeddings.
KNOWLEDGE_CHUNK_CHARACTERS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=200
KNOWLEDGE_EMBEDDING_PROVIDER=ollama
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16

# Build 013 local retrieval.
KNOWLEDGE_SEARCH_TOP_K=8

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=5
OLLAMA_GENERATION_TIMEOUT_SECONDS=120

# Build 010 reliability policy.
# Generation attempts include the first try. Retries only happen before any token is emitted.
PROVIDER_GENERATION_ATTEMPTS=2
PROVIDER_RETRY_DELAY_SECONDS=0.35
PROVIDER_OFFLINE_COOLDOWN_SECONDS=5

# Build 021 read-only Home Assistant connection.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=5

# Build 025 authenticated local MQTT foundation.
# Host is a hostname/IP, not a URL. Allowed topics are comma-separated MQTT filters.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=rosevear-ai-hub
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=30
MQTT_ALLOWED_TOPICS=

# Build 032 local go2rtc transport.
# Keep the API on localhost. Camera source URLs/credentials are stored encrypted in SQLite.
GO2RTC_BASE_URL=http://127.0.0.1:1984
GO2RTC_TIMEOUT_SECONDS=5
GO2RTC_RTSP_BASE_URL=rtsp://127.0.0.1:8554
CAMERA_HEALTH_STALE_SECONDS=300
FRIGATE_BASE_URL=http://127.0.0.1:5000
FRIGATE_TIMEOUT_SECONDS=5
FRIGATE_EVENT_LIMIT=20
FRIGATE_EVENT_POLL_SECONDS=2

# Build 037 read-only Devil n Dove business connector.
# Keep the bearer-equivalent admin session credential server-side. Prefer Secrets for storage.
DEVILNDOVE_BASE_URL=https://devilndove.com
DEVILNDOVE_ADMIN_TOKEN=
DEVILNDOVE_TIMEOUT_SECONDS=8

# Build 038 read-only Rosie Dazzlers business connector.
# Store only the opaque rd_staff_session token value. Prefer Secrets for storage.
ROSIEDAZZLERS_BASE_URL=https://rosiedazzlers.ca
ROSIEDAZZLERS_STAFF_SESSION_TOKEN=
ROSIEDAZZLERS_TIMEOUT_SECONDS=8

# Build 039 read-only Yard Workers business connector.
# Use a signed-in Supabase user token with Jobs module view access and the paired project API key.
# Prefer Secrets for both credential values.
YARDWORKERS_BASE_URL=https://jmqvkgiqlimdhcofwkxr.supabase.co
YARDWORKERS_ACCESS_TOKEN=
YARDWORKERS_ANON_KEY=
YARDWORKERS_TIMEOUT_SECONDS=8
