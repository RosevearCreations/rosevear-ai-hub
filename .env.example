APP_NAME=Rosevear AI Hub
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/rosevear_ai_hub.db

# Build 011 local knowledge storage.
KNOWLEDGE_STORAGE_DIR=./data/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
KNOWLEDGE_MAX_EXPANDED_DOCX_BYTES=104857600

# Build 012 local chunking and embeddings.
KNOWLEDGE_CHUNK_CHARACTERS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=200
KNOWLEDGE_EMBEDDING_PROVIDER=ollama
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=5
OLLAMA_GENERATION_TIMEOUT_SECONDS=120

# Build 010 reliability policy.
# Generation attempts include the first try. Retries only happen before any token is emitted.
PROVIDER_GENERATION_ATTEMPTS=2
PROVIDER_RETRY_DELAY_SECONDS=0.35
PROVIDER_OFFLINE_COOLDOWN_SECONDS=5

HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
