{
  "name": "rosevear-ai-hub",
  "private": true,
  "version": "0.0.5",
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:test": "npm --workspace apps/web run test",
    "web:typecheck": "npm --workspace apps/web run typecheck",
    "integration:ql246:contract:test": "node --test scripts/ql246-source-proof-contract.test.mjs",
    "integration:ql252:hub:check": "node scripts/ql252-hub-public-check.mjs",
    "integration:ql252:hub:test": "node scripts/ql252-hub-public-check.test.mjs",
    "integration:ql252:publication:check": "node scripts/ql252-hub-publication-guard.mjs",
    "integration:ql252:publication:test": "node scripts/ql252-hub-publication-guard.test.mjs",
    "integration:ql253:hub:check": "node scripts/ql253-hub-provenance-readiness.mjs",
    "integration:ql253:hub:test": "node scripts/ql253-hub-provenance-readiness.test.mjs",
    "integration:ql254:hub:check": "node scripts/ql254-hub-provenance-relay.mjs",
    "integration:ql254:hub:test": "node scripts/ql254-hub-provenance-relay.test.mjs",
    "integration:ql256:hub:check": "node scripts/ql256-hub-source-custody.mjs",
    "integration:ql256:hub:test": "node scripts/ql256-hub-source-custody.test.mjs",
    "integration:ql256:witness:check": "node scripts/ql256-hub-witness-envelope.mjs",
    "integration:ql256:witness:test": "node scripts/ql256-hub-witness-envelope.test.mjs",
    "desktop:dev": "npm --workspace apps/desktop run dev",
    "desktop:check": "npm --workspace apps/desktop run check",
    "desktop:build": "npm run web:build && npm --workspace apps/desktop run build",
    "integration:ql257:hub:check": "node scripts/ql257-hub-checkpoint.mjs",
    "integration:ql257:hub:test": "node scripts/ql257-hub-checkpoint.test.mjs",
    "integration:ql258:hub:check": "node scripts/ql258-hub-public-refresh.mjs",
    "integration:ql258:hub:test": "node scripts/ql258-hub-public-refresh.test.mjs"
  }
}
