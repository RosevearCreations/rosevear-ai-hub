# Build 032 local-only go2rtc baseline.
# Camera source URLs are NOT stored here. Rosevear AI Hub keeps them encrypted
# and patches them into go2rtc runtime memory after startup.

api:
  listen: "127.0.0.1:1984"

rtsp:
  listen: "127.0.0.1:8554"

webrtc:
  listen: "127.0.0.1:8555"
  candidates:
    - "127.0.0.1:8555"

streams: {}
